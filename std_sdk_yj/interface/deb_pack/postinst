#!/bin/bash

sudo chmod 777 /opt/robot/share/motion_master/ -R
sudo chmod +x /opt/robot/share/motion_master/scripts/run.sh
sudo cp /opt/robot/share/motion_master/scripts/motion_master.service /lib/systemd/system/
sudo bash -c "echo '/var/opt/robot/log/system/coredump.%e.%p.%t' > /proc/sys/kernel/core_pattern"
sudo chmod 666 /opt/robot/share/motion_master/bin/motion_master
sudo setcap cap_sys_nice,cap_net_raw,cap_net_admin+ep /opt/robot/share/motion_master/bin/motion_master
sudo chmod +x /opt/robot/share/motion_master/bin/motion_master


systemctl daemon-reload
sudo systemctl set-default multi-user.target

#systemctl enable motion_master.service
systemctl restart motion_master.service

exit 0
