[Unit]
Description=motion_master
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
SupplementaryGroups=video audio tty dialout bluetooth
User=user
Group=user
ExecStart=/opt/robot/share/motion_master/scripts/run.sh
Restart=on-failure
RestartPreventExitStatus=SIGTERM SIGSEGV

[Install]
WantedBy=multi-user.target